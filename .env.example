# Copy this file to .env, fill in your real key, and never commit .env.
#
# Get a FREE key at https://aistudio.google.com/apikey (sign in with any
# Google account, click "Create API key"). The chat widget will not work
# without this set.
GEMINI_API_KEY=AIza...

# Optional: override the model the assistant uses. Defaults to
# gemini-2.5-flash if unset. See https://ai.google.dev/gemini-api/docs/models
# for the current list of model IDs and which ones are free-tier eligible --
# these change over time, so check there rather than trusting an old value.
# GEMINI_MODEL=gemini-2.5-flash
